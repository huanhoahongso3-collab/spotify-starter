<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pill_overlay"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:elevation="12dp"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <!-- Spotify Sync Action Area -->
    <LinearLayout
        android:id="@+id/btn_sync_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_spotify_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:clickable="false"
            android:focusable="false"
            android:contentDescription="Spotify"
            android:src="@drawable/ic_spotify" />

        <TextView
            android:id="@+id/tv_overlay_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:clickable="false"
            android:focusable="false"
            android:text="@string/overlay_sync_text"
            android:textColor="@color/spotify_white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="20dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:background="#44FFFFFF" />

    <!-- Dismiss Button -->
    <ImageView
        android:id="@+id/btn_close_overlay"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:clickable="false"
        android:focusable="false"
        android:contentDescription="@string/overlay_dismiss"
        android:padding="4dp"
        android:src="@drawable/ic_close" />

</LinearLayout>
